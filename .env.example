#! === Example Environment Files ===
#! Style Guide: Value always in quotes.

# Base Github URL for the application. This is used for generating links
# like bug reports and documentation.
GITHUB_REMOTE = "https://github.com/Anatoly03/Torii"

# Base Github API URL for the application releases. This is used for
# fetching for new releases and updates. 
GITHUB_RELEASES = "https://api.github.com/repos/Anatoly03/Torii/releases"
